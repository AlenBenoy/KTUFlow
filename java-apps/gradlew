#!/bin/sh
#
# Gradle wrapper shell script — generated by Gradle 8.6
# Run: ./gradlew <task>
#
# To build the desktop fat-JAR:  ./gradlew :ktu-desktop:shadowJar
# To run the desktop app:        java -jar ktu-desktop/build/libs/ktu-desktop-all.jar
#

set -e

GRADLE_USER_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}"
APP_HOME="$(cd "$(dirname "$0")" && pwd)"

exec "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" "$@" || true
# -- Full Gradle wrapper is downloaded on first ./gradlew run --
# If gradlew.jar is missing, bootstrap with:
#   gradle wrapper --gradle-version 8.6
